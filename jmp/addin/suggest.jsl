// Suggest Next Runs: fit a model to the measured rows and add the rows it would measure next.
// The new rows are appended (and selected) with no response; Measure This Table measures them.
// This is one step of the Bayesian optimization loop, driven from JMP.
Names Default To Here( 1 );
Include( "$ADDIN_HOME(com.hartmann.optsim)/common.jsl" );

dt = Current Data Table();
If( Is Empty( dt ),
	hsMessage( "Hartmann Simulator", "Open a measured design table first." );
	Throw();
);
lab = hsLabOf( dt );
If( lab == "",
	hsMessage( "Hartmann Simulator", "Measure this table first (Hartmann Simulator > Measure This Table); that also sets its lab." );
	Throw();
);

methodLabels = {"Bayesian optimization (Gaussian process)", "Quadratic RSM: go to the predicted minimum", "Random point(s)"};
methodKeys = {"bo", "rsm", "random"};
acqLabels = {"Expected improvement", "Probability of improvement", "Confidence bound (UCB)",
	"Exploit: lowest predicted mean", "Explore: highest uncertainty"};
acqKeys = {"ei", "pi", "ucb", "exploit", "explore"};
kernelLabels = {"Matern 5/2", "Matern 3/2", "RBF (squared exponential)"};
kernelKeys = {"matern52", "matern32", "rbf"};

hsSuggest = Function( {},
	{Default Local},
	Try(
		hsLab = lab;
		hsMethod = methodKeys[methodBox << Get];
		hsAcq = acqKeys[acqBox << Get];
		hsKernel = kernelKeys[kernelBox << Get];
		hsQ = runsBox << Get;
		If( Is Missing( hsQ ) | hsQ < 1, hsQ = 1 );
		Python Send( dt );
		Python Send( hsLab );
		Python Send( hsMethod );
		Python Send( hsAcq );
		Python Send( hsKernel );
		Python Send( hsQ );
		Python Submit( "\[
from hartmann import jmp_adapter
hs_result = jmp_adapter.to_json(jmp_adapter.suggest_table(
    dt, hsLab, method=hsMethod, acquisition=hsAcq, q=int(hsQ), kernel=hsKernel))
]\" );
		result = Parse JSON( Python Get( hs_result ) );
		cols = result["columns"];
		pts = result["points"];
		n0 = N Rows( dt );
		dt << Add Rows( N Items( pts ) );
		For( r = 1, r <= N Items( pts ), r++,
			For( c = 1, c <= N Items( cols ), c++,
				Column( dt, cols[c] )[n0 + r] = pts[r][c]
			)
		);
		dt << Clear Select;
		dt << Select Rows( Index( n0 + 1, n0 + N Items( pts ) ) );
		win << Close Window;
		hsMessage( "Hartmann Simulator", result["message"] );
	,
		hsMessage( "Hartmann Simulator", "No rows were added: " || Char( exception_msg ) )
	);
);

win = New Window( "Hartmann Simulator: suggest next runs",
	V List Box(
		Text Box( "Lab: " || hsDescribe( lab ), << Set Wrap( 560 ) ),
		Spacer Box( Size( 0, 6 ) ),
		Lineup Box( N Col( 2 ),
			Text Box( "Method" ), methodBox = Combo Box( methodLabels ),
			Text Box( "Acquisition (Bayesian optimization)" ), acqBox = Combo Box( acqLabels ),
			Text Box( "Kernel (Bayesian optimization)" ), kernelBox = Combo Box( kernelLabels ),
			Text Box( "Runs to add" ), runsBox = Number Edit Box( 1 )
		),
		Spacer Box( Size( 0, 6 ) ),
		Text Box( "Every factor needs a column. Suggestions never go past the budget, counting rows still waiting to be measured.",
			<< Set Wrap( 560 ) ),
		Spacer Box( Size( 0, 8 ) ),
		H List Box(
			Button Box( "Suggest", hsSuggest() ),
			Button Box( "Cancel", win << Close Window )
		)
	)
);
